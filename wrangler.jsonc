{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoshimiaki-mahjong",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // The /mahjong/* domain route is attached once in the Cloudflare dashboard.
  // See docs/DEPLOYMENT_CN.md for the GitHub -> Workers Builds workflow.
  "assets": {
    "directory": "./dist",
    "base_path": "/mahjong",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  }
}
